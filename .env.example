# ==================================================================
# MEDAI · Environment template — copy to ".env" and fill the values.
# NEVER commit the real .env file. It is already in .gitignore.
# ==================================================================

# ---------- AI (backend only — keys never reach the frontend) ----------
AI_PROVIDER=openai          # openai | mock  (mock = curated demo answers)
AI_API_KEY=                 # e.g. sk-proj-... from your AI provider dashboard
AI_MODEL=gpt-4o-mini        # any chat-completions-compatible model name

# ---------- Security ----------
SECRET_KEY=                 # long random string: openssl rand -hex 32
RATE_LIMIT_PER_MIN=60

# ---------- Database ----------
DATABASE_URL=               # e.g. postgresql://user:pass@host:5432/medai

# ---------- Server ----------
ENVIRONMENT=development     # development | production
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ---------- Frontend (create frontend .env — must start with VITE_) ----------
VITE_API_URL=http://localhost:8000

# Authentication / database (backend only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=replace-with-a-long-random-secret
SESSION_TTL_DAYS=7
# Temporary bootstrap only; remove from Render after creating the first super_admin.
ADMIN_BOOTSTRAP_TOKEN=
